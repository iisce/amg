// This is your Prisma schema file
// Prisma 7 configuration - Database URL is in prisma.config.ts

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// USER & AUTHENTICATION
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String // Hashed password
  name          String
  phone         String?
  company       String? // Company/organization name
  avatar        String?
  role          UserRole  @default(CLIENT)
  isActive      Boolean   @default(true)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  bookings           Booking[]
  memberships        Membership[]
  passwordResetToken PasswordResetToken?
  sessions           Session[]
  accounts           Account[]
  payments           Payment[]
  activityLogs       ActivityLog[]
  enquiries          Enquiry[]
  teamMemberships    MembershipMember[] // Team memberships where user is a member
  visitors           Visitor[]          @relation("VisitorHost") // Visitors this user is hosting

  @@index([email])
  @@index([role])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionToken])
  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
}

enum UserRole {
  CLIENT
  STAFF
  FRONT_DESK
  FRONT_DESK_ASSISTANT
  ADMIN
  SUPER_ADMIN
}

// ============================================
// SPACES & PRICING
// ============================================

model Space {
  id              String        @id @default(cuid())
  name            String
  slug            String        @unique
  description     String        @db.Text
  fullDescription String?       @db.Text
  capacity        Int
  amenities       String[]
  features        String[]
  images          String[]
  category        SpaceCategory @default(WORKSPACE)
  type            SpaceType     @default(BOOKING)
  isActive        Boolean       @default(true)
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  pricingPlans PricingPlan[]
  bookings     Booking[]
  memberships  Membership[]
  timeSlots    TimeSlot[]
  enquiries    Enquiry[]
  planPerks    PlanPerk[]    @relation("PerkSpace") // Spaces available as perks
  addons       Addon[] // Add-ons that give access to this space

  @@index([slug])
  @@index([category])
  @@index([type])
  @@index([isActive])
}

model PricingPlan {
  id          String   @id @default(cuid())
  spaceId     String
  name        String
  description String?
  price       Int // Price in kobo (smallest currency unit)
  duration    Int? // Duration in hours (for hourly bookings)
  unit        String   @default("day") // day, week, month, hour, session
  type        PlanType
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Subscription-specific fields
  daysAllowed     Int? // Number of days allowed per billing period (null = unlimited)
  maxPauseDays    Int     @default(0) // Maximum days subscription can be paused
  carryOver       Boolean @default(false) // Whether unused days carry over
  timeRestriction String? // Time restriction e.g., "18:00-21:00" for Evening Plan
  dayRestriction  String? // Day restriction e.g., "SATURDAY" for Saturday Plans

  // Relations
  space           Space        @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  bookings        Booking[]
  memberships     Membership[]
  perks           PlanPerk[] // Included benefits (e.g., "1 hr Board Room per week")
  availableAddons Addon[]      @relation("AddonPlans") // Add-ons purchasable with this plan

  @@index([spaceId])
  @@index([type])
  @@index([isActive])
}

model TimeSlot {
  id        String   @id @default(cuid())
  spaceId   String
  startTime String // Format: "09:00"
  endTime   String // Format: "11:00"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([spaceId])
}

enum SpaceCategory {
  WORKSPACE
  OFFICE
  MEETING
  CREATIVE
  EVENT
  SOCIAL
}

enum SpaceType {
  SUBSCRIPTION // Long-term (shared desks, private offices)
  BOOKING // Short-term (board room, studio, lounge)
}

enum PlanType {
  HOURLY
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

// ============================================
// PLAN PERKS & ADD-ONS
// ============================================

// Benefits included with a pricing plan (e.g., "1 hr Board Room per week")
model PlanPerk {
  id            String  @id @default(cuid())
  pricingPlanId String
  name          String // Display name: "Board Room Access"
  description   String? // "1 hour per week"

  // What space they get access to (null for general perks like "Lounge Access")
  includedSpaceId String?

  // Duration and limits
  durationMinutes Int // e.g., 60 for 1 hour (0 for unlimited access like lounge)
  limitPerPeriod  Int        @default(1) // e.g., 1 (1 time per period)
  periodType      PerkPeriod @default(WEEKLY) // DAILY, WEEKLY, MONTHLY, SUBSCRIPTION_PERIOD
  isUnlimited     Boolean    @default(false) // True for things like "Free lounge access"

  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  pricingPlan   PricingPlan @relation(fields: [pricingPlanId], references: [id], onDelete: Cascade)
  includedSpace Space?      @relation("PerkSpace", fields: [includedSpaceId], references: [id])
  usages        PerkUsage[]

  @@index([pricingPlanId])
  @@index([includedSpaceId])
  @@index([isActive])
}

// Track usage of plan perks
model PerkUsage {
  id           String   @id @default(cuid())
  perkId       String
  membershipId String
  bookingId    String?  @unique // Optional: if a booking was created
  usedAt       DateTime @default(now())
  durationUsed Int // Minutes used
  notes        String?
  createdAt    DateTime @default(now())

  // Relations
  perk       PlanPerk   @relation(fields: [perkId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  booking    Booking?   @relation(fields: [bookingId], references: [id])

  @@index([perkId])
  @@index([membershipId])
  @@index([usedAt])
}

// Purchasable add-ons (e.g., "Photo studio ₦5,000/hr")
model Addon {
  id          String  @id @default(cuid())
  name        String // "Photo Studio Session"
  description String?
  spaceId     String? // What space does this addon give access to (null for non-space addons)

  // Pricing
  price           Int // Price in kobo
  durationMinutes Int @default(60) // Duration included (e.g., 60 for 1 hour)

  // Availability
  isActive             Boolean @default(true)
  availableForAllPlans Boolean @default(true) // If false, check availablePlans

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  space          Space?          @relation(fields: [spaceId], references: [id])
  availablePlans PricingPlan[]   @relation("AddonPlans") // Plans that can purchase this addon
  purchases      AddonPurchase[]

  @@index([spaceId])
  @@index([isActive])
}

// Track addon purchases
model AddonPurchase {
  id           String  @id @default(cuid())
  addonId      String
  membershipId String
  paymentId    String?
  bookingId    String? @unique // If a booking was created from this addon

  // Quantity and usage
  quantity     Int @default(1) // How many units purchased
  usedQuantity Int @default(0) // How many used

  // Pricing at time of purchase
  unitPrice   Int // Price per unit at purchase time (in kobo)
  totalAmount Int // Total amount paid (in kobo)

  status    AddonPurchaseStatus @default(PENDING)
  expiresAt DateTime? // When the addon expires (null = never)
  notes     String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  // Relations
  addon      Addon      @relation(fields: [addonId], references: [id])
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  payment    Payment?   @relation(fields: [paymentId], references: [id])
  booking    Booking?   @relation(fields: [bookingId], references: [id])

  @@index([addonId])
  @@index([membershipId])
  @@index([status])
  @@index([expiresAt])
}

enum PerkPeriod {
  DAILY
  WEEKLY
  MONTHLY
  SUBSCRIPTION_PERIOD // Resets each billing cycle
}

enum AddonPurchaseStatus {
  PENDING
  ACTIVE
  USED
  EXPIRED
  CANCELLED
}

// ============================================
// BOOKINGS
// ============================================

model Booking {
  id            String        @id @default(cuid())
  bookingNumber String        @unique // Human-readable: AMG-BK-XXXXXX
  userId        String
  spaceId       String
  pricingPlanId String
  bookingDate   DateTime
  startTime     DateTime
  endTime       DateTime
  attendees     Int           @default(1)
  totalAmount   Int // Amount in kobo
  status        BookingStatus @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  qrCode        String        @unique
  checkInTime   DateTime?
  checkOutTime  DateTime?
  notes         String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Contact info (for guest bookings or additional contact)
  contactName  String?
  contactEmail String?
  contactPhone String?

  // Relations
  user          User           @relation(fields: [userId], references: [id])
  space         Space          @relation(fields: [spaceId], references: [id])
  pricingPlan   PricingPlan    @relation(fields: [pricingPlanId], references: [id])
  payment       Payment?
  perkUsage     PerkUsage? // If created from a plan perk
  addonPurchase AddonPurchase? // If created from an addon purchase

  @@index([userId])
  @@index([spaceId])
  @@index([bookingDate])
  @@index([qrCode])
  @@index([bookingNumber])
  @@index([status])
  @@index([paymentStatus])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

// ============================================
// PAYMENTS
// ============================================

model Payment {
  id              String        @id @default(cuid())
  reference       String        @unique // Our internal reference: AMG-PAY-XXXXXX
  userId          String
  bookingId       String?       @unique
  membershipId    String?       @unique
  amount          Int // Amount in kobo
  currency        String        @default("NGN")
  method          PaymentMethod @default(CARD)
  provider        String        @default("paystack") // paystack, flutterwave, transfer
  providerRef     String? // Reference from payment provider
  status          PaymentStatus @default(PENDING)
  paidAt          DateTime?
  refundedAt      DateTime?
  refundReason    String?
  gatewayResponse Json? // Full response from payment gateway
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  user           User            @relation(fields: [userId], references: [id])
  booking        Booking?        @relation(fields: [bookingId], references: [id])
  membership     Membership?     @relation(fields: [membershipId], references: [id])
  addonPurchases AddonPurchase[] // Addon purchases paid with this payment

  @@index([reference])
  @@index([userId])
  @@index([providerRef])
  @@index([status])
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  USSD
  CASH
}

// ============================================
// MEMBERSHIPS / SUBSCRIPTIONS
// ============================================

model Membership {
  id               String           @id @default(cuid())
  membershipNumber String           @unique // Human-readable: AMG-MB-XXXXXX
  userId           String
  spaceId          String
  pricingPlanId    String
  type             MembershipType
  totalAmount      Int // Price in kobo
  startDate        DateTime
  endDate          DateTime
  status           MembershipStatus @default(PENDING)
  paymentStatus    PaymentStatus    @default(PENDING)
  accessCode       String?          @unique // For access control
  assignedDesk     String? // Desk number if applicable
  autoRenew        Boolean          @default(false)
  renewedAt        DateTime? // Last renewal date
  notes            String?          @db.Text

  // For fixed-day subscriptions (e.g., 10 days per month)
  daysAllowed Int? // Number of days allowed per billing period

  // Team/Company membership fields
  companyName       String? // Company name for team subscriptions
  maxMembers        Int       @default(1) // Maximum team members allowed (base + addons)
  currentOccupancy  Int       @default(0) // Current number of checked-in members

  // Pause functionality
  pausedAt        DateTime? // When subscription was paused
  totalPausedDays Int       @default(0) // Total days paused in current period
  pauseHistory    Json? // Array of pause/resume records [{pausedAt, resumedAt, days}]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user           User                @relation(fields: [userId], references: [id])
  space          Space               @relation(fields: [spaceId], references: [id])
  pricingPlan    PricingPlan         @relation(fields: [pricingPlanId], references: [id])
  payments       Payment[]
  checkIns       MembershipCheckIn[]
  perkUsages     PerkUsage[] // Track usage of plan perks
  addonPurchases AddonPurchase[] // Purchased add-ons
  teamMembers    MembershipMember[] // Team members for this subscription
  visitors       Visitor[] // Visitors to this membership

  @@index([userId])
  @@index([spaceId])
  @@index([endDate])
  @@index([status])
  @@index([membershipNumber])
  @@index([accessCode])
  @@index([companyName])
}

// Team members linked to a membership subscription
model MembershipMember {
  id           String  @id @default(cuid())
  membershipId String
  userId       String? // Optional: linked user account (null for guest members)

  // For guest members without accounts
  name         String // Required: member's name
  email        String? // Optional: for notifications
  phone        String? // Optional: for contact

  // Access control
  accessCode   String  @unique // Unique QR/access code for this team member
  isActive     Boolean @default(true)
  isPrimary    Boolean @default(false) // True for the subscription owner

  // Invitation system
  invitationToken   String?   @unique // Token sent via email to invite user to create account
  invitationSentAt  DateTime? // When invitation was sent
  invitationExpires DateTime? // When invitation expires
  qrCodeSentAt      DateTime? // When QR code was last emailed

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  membership Membership          @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  user       User?               @relation(fields: [userId], references: [id])
  checkIns   MembershipCheckIn[]

  @@unique([membershipId, email]) // Prevent duplicate email per membership
  @@index([membershipId])
  @@index([userId])
  @@index([accessCode])
  @@index([isActive])
  @@index([invitationToken])
}

// Track attendance/check-ins for memberships
model MembershipCheckIn {
  id           String    @id @default(cuid())
  membershipId String
  memberId     String? // Optional: specific team member who checked in
  checkInTime  DateTime  @default(now())
  checkOutTime DateTime?
  checkedInBy  String? // Admin/staff who processed check-in (for front desk)
  notes        String?
  createdAt    DateTime  @default(now())

  // Relations
  membership Membership        @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  member     MembershipMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([membershipId])
  @@index([memberId])
  @@index([checkInTime])
}

enum MembershipType {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum MembershipStatus {
  PENDING
  ACTIVE
  PAUSED
  EXPIRED
  CANCELLED
  SUSPENDED
}

// ============================================
// VISITORS
// ============================================

// Visitors are temporary guests who visit members/subscribers
model Visitor {
  id        String  @id @default(cuid())

  // Visitor info
  name      String
  email     String?
  phone     String?
  company   String? // Visitor's company
  purpose   String? // Purpose of visit

  // Who they're visiting
  hostId    String  // User being visited (member/subscriber)
  hostMembershipId String? // Optional: specific membership subscription

  // Access control
  accessCode    String   @unique // QR code for visitor check-in
  validFrom     DateTime @default(now())
  validUntil    DateTime // When visitor access expires
  maxDuration   Int      @default(480) // Max visit duration in minutes (default 8 hours)

  // Check-in status
  checkInTime   DateTime?
  checkOutTime  DateTime?
  checkedInBy   String? // Admin/staff who processed check-in

  // Status
  status    VisitorStatus @default(PENDING)
  notes     String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  host       User        @relation("VisitorHost", fields: [hostId], references: [id])
  membership Membership? @relation(fields: [hostMembershipId], references: [id])

  @@index([hostId])
  @@index([hostMembershipId])
  @@index([accessCode])
  @@index([status])
  @@index([validFrom, validUntil])
  @@index([checkInTime])
}

enum VisitorStatus {
  PENDING    // Visitor registered but not yet arrived
  CHECKED_IN // Visitor is currently in the workspace
  CHECKED_OUT // Visitor has left
  EXPIRED    // Visit time expired without check-in
  CANCELLED  // Visit was cancelled
}

// ============================================
// PUBLIC HOLIDAYS
// ============================================

model PublicHoliday {
  id          String   @id @default(cuid())
  name        String // e.g., "Christmas Day", "New Year's Day"
  date        DateTime // The holiday date
  isRecurring Boolean  @default(false) // Repeats yearly (like Christmas) or one-time
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([isActive])
}

// ============================================
// ENQUIRIES
// ============================================

model Enquiry {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  spaceId   String? // Optional - specific space inquiry
  subject   String
  message   String        @db.Text
  status    EnquiryStatus @default(NEW)
  userId    String? // If user was logged in
  notes     String?       @db.Text // Admin notes
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // Relations
  space Space? @relation(fields: [spaceId], references: [id])
  user  User?  @relation(fields: [userId], references: [id])

  @@index([email])
  @@index([spaceId])
  @@index([status])
  @@index([createdAt])
}

enum EnquiryStatus {
  NEW
  IN_PROGRESS
  RESPONDED
  CLOSED
}

// ============================================
// AUDIT & ACTIVITY LOGS
// ============================================

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String // e.g., "booking.created", "user.login"
  entityType String? // e.g., "Booking", "User"
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  // Relations
  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ============================================
// TOUR BOOKING (Workspace Inspection)
// ============================================

model Tour {
  id        String @id @default(cuid())

  // Contact info
  name      String
  email     String
  phone     String?
  company   String?

  // Scheduling
  preferredDate DateTime  // Requested date/time
  confirmedDate DateTime? // Actual confirmed slot
  duration      Int       @default(30) // Duration in minutes

  // Interest details
  interestedIn String? // "Private Office", "Shared Desk", "Meeting Room", etc.
  groupSize    Int     @default(1) // Number of people touring
  budget       String? // Budget range
  source       String? // How they heard about AMG: "Google", "Instagram", "Referral", etc.
  message      String? // Additional message/questions

  // Status tracking
  status      TourStatus @default(PENDING)
  confirmedBy String?    // Admin who confirmed the tour
  conductedBy String?    // Staff who gave the tour
  feedback    String?    // Post-tour notes from staff

  // Conversion tracking
  converted            Boolean @default(false)
  convertedToMembershipId String? // If they signed up, link to their membership

  // Reminder tracking
  reminderSent Boolean @default(false)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([preferredDate])
  @@index([confirmedDate])
  @@index([createdAt])
}

enum TourStatus {
  PENDING   // Awaiting admin confirmation
  CONFIRMED // Appointment confirmed
  COMPLETED // Tour conducted
  CANCELLED // Cancelled by prospect or admin
  NO_SHOW   // Prospect didn't show up
}

// ============================================
// INVENTORY MANAGEMENT
// ============================================

model InventoryCategory {
  id          String  @id @default(cuid())
  name        String  @unique // "Beverages", "Disposables", "Snacks", etc.
  description String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  items InventoryItem[]

  @@index([isActive])
}

model InventoryItem {
  id         String @id @default(cuid())
  categoryId String
  name       String // "Sugar", "Coffee Sachet", "Disposable Cup Small"
  sku        String @unique // Stock Keeping Unit: "INV-SUG-001"
  description String?

  // Unit management
  baseUnit      String // Smallest trackable unit: "cube", "sachet", "piece", "ml", "gram"
  packageUnit   String? // Larger unit for bulk: "pack", "box", "carton", "bottle"
  unitsPerPackage Int  @default(1) // How many base units in a package (100 cubes per pack)

  // Stock tracking (always in base units)
  currentStock  Int @default(0) // Current stock in base units
  reorderLevel  Int @default(10) // Alert when stock falls below this
  optimalStock  Int @default(100) // Target stock level

  // Pricing (for reference, inventory items don't have sale price)
  costPerUnit   Int @default(0) // Cost per base unit in kobo (for profit calculation)

  // Visibility
  isActive      Boolean @default(true)
  showInShop    Boolean @default(false) // Direct sale in shop (standalone items)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  category     InventoryCategory      @relation(fields: [categoryId], references: [id])
  transactions InventoryTransaction[]
  shopItemComponents ShopItemComponent[] // Used in composite shop items
  shopItem     ShopItem? // Direct shop item link (for standalone items)

  @@index([categoryId])
  @@index([sku])
  @@index([isActive])
  @@index([showInShop])
  @@index([currentStock])
}

model InventoryTransaction {
  id              String @id @default(cuid())
  inventoryItemId String
  type            InventoryTransactionType
  quantity        Int // Positive for additions, negative for deductions (in base units)
  previousStock   Int // Stock before transaction
  newStock        Int // Stock after transaction

  // Reference to what caused this transaction
  referenceType   String? // "SHOP_ORDER", "MANUAL_ADJUSTMENT", "RESTOCK", "DAMAGE", etc.
  referenceId     String? // ID of the related record (shopOrderId, etc.)

  // Additional info
  notes           String?
  performedBy     String? // User ID who performed the action
  costPerUnit     Int? // Cost at time of transaction (for restocks)
  totalCost       Int? // Total cost of transaction in kobo

  createdAt DateTime @default(now())

  // Relations
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId])
  @@index([type])
  @@index([referenceType, referenceId])
  @@index([createdAt])
}

enum InventoryTransactionType {
  RESTOCK       // Adding new stock
  SALE          // Sold through shop
  ADJUSTMENT    // Manual correction
  DAMAGE        // Damaged/expired items
  TRANSFER      // Moved between locations
  RETURN        // Returned to supplier
}

// ============================================
// SHOP MANAGEMENT
// ============================================

model ShopCategory {
  id          String  @id @default(cuid())
  name        String  @unique // "Hot Drinks", "Cold Drinks", "Snacks", "Meals"
  description String?
  image       String? // Category image
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  items ShopItem[]

  @@index([isActive])
}

model ShopItem {
  id          String @id @default(cuid())
  categoryId  String
  name        String // "Coffee Cup Small", "Bottle of Coke", "Chin Chin"
  description String?
  image       String? // Product image

  // Pricing (in kobo)
  price       Int // Sale price

  // Item type
  isComposite Boolean @default(false) // Made from multiple inventory items
  inventoryItemId String? @unique // For standalone items - direct link to inventory

  // For composite items
  preparationTime Int? // Time to prepare in minutes (display "Ready in X mins")

  // Availability
  isActive    Boolean @default(true)
  isAvailable Boolean @default(true) // Auto-set based on component availability
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  category       ShopCategory       @relation(fields: [categoryId], references: [id])
  inventoryItem  InventoryItem?     @relation(fields: [inventoryItemId], references: [id])
  components     ShopItemComponent[] // Recipe/BOM for composite items
  orderItems     ShopOrderItem[]

  @@index([categoryId])
  @@index([isActive])
  @@index([isAvailable])
  @@index([inventoryItemId])
}

// Recipe/Bill of Materials for composite shop items
model ShopItemComponent {
  id              String @id @default(cuid())
  shopItemId      String
  inventoryItemId String
  quantity        Int // Quantity of inventory item needed (in base units)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  shopItem      ShopItem      @relation(fields: [shopItemId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@unique([shopItemId, inventoryItemId]) // One inventory item per shop item
  @@index([shopItemId])
  @@index([inventoryItemId])
}

model ShopOrder {
  id          String @id @default(cuid())
  orderNumber String @unique // Human-readable: AMG-SHP-XXXXXX
  userId      String? // Optional - can be guest purchase

  // Customer info (for guest orders or override)
  customerName  String?
  customerEmail String?
  customerPhone String?

  // Order details
  subtotal    Int // Subtotal in kobo
  tax         Int @default(0) // Tax in kobo (if applicable)
  totalAmount Int // Final amount in kobo

  // Payment
  paymentStatus   PaymentStatus @default(PENDING)
  paymentMethod   PaymentMethod?
  paymentRef      String? // Paystack reference
  paidAt          DateTime?

  // Order status
  status      ShopOrderStatus @default(PENDING)

  // Fulfillment tracking
  preparedBy    String? // Staff who prepared the order
  preparedAt    DateTime?
  servedBy      String? // Staff who served/delivered
  servedAt      DateTime?

  // Estimated completion
  estimatedReadyAt DateTime? // When order should be ready

  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  items ShopOrderItem[]

  @@index([orderNumber])
  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model ShopOrderItem {
  id          String @id @default(cuid())
  orderId     String
  shopItemId  String
  quantity    Int @default(1)
  unitPrice   Int // Price at time of order (in kobo)
  totalPrice  Int // quantity * unitPrice

  // For tracking
  notes       String? // Special requests: "No sugar", "Extra hot"

  createdAt DateTime @default(now())

  // Relations
  order    ShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shopItem ShopItem  @relation(fields: [shopItemId], references: [id])

  @@index([orderId])
  @@index([shopItemId])
}

enum ShopOrderStatus {
  PENDING       // Order placed, awaiting payment
  PAID          // Payment confirmed, awaiting preparation
  PREPARING     // Being prepared
  READY         // Ready for pickup/serving
  SERVED        // Delivered to customer
  CANCELLED     // Order cancelled
}
